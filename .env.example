# Protect the /login and /session endpoints. Use a long random value.
AUTOMATION_API_KEY=replace-with-a-long-random-key

# Odoo login page
ODOO_LOGIN_URL=https://124570667-saas-19-4-all.runbot317.odoo.com/web/login

# Preferred: HashiCorp Vault KV v2 (fields: login, password)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=replace-me
VAULT_SECRET_PATH=secret/data/odoo/runbot

# Fallback only when Vault is not configured
# ODOO_LOGIN=user@example.com
# ODOO_PASSWORD=replace-me

SESSION_FILE=/data/odoo-session.json
SESSION_TTL_SECONDS=3600
